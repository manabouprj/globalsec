# GlobalSec — gitignore

# === Secrets — NEVER COMMIT ===
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cert
secrets/
credentials/
*token*
*api_key*

# === Editor backups ===
*.bak
*.swp
*.tmp
*~
.idea/
.vscode/settings.json
.vscode/launch.json

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# === Virtual environments ===
venv/
env/
.venv/
.env_venv/

# === Node.js (for SPOG dashboard) ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.nuxt/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Build/Deploy ===
*.tfstate
*.tfstate.backup
.terraform/
*.tfvars
!*.tfvars.example

# === Logs ===
*.log
logs/

# === Reports (generated) ===
reports/generated/
*.pdf
!docs/**/*.pdf
