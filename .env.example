# GlobalSec — Environment Variables Reference
# =============================================
# DO NOT commit a populated .env file. Production secrets live ONLY in your
# secret store (Azure Key Vault / AWS Secrets Manager / HashiCorp Vault / etc).
# This file documents what each agent needs.

# ============ CLOUD PROVIDER (Level 2 multi-cloud) ============
# Selects which implementation of SecretProvider, EventBus, ObjectStore,
# and IdentityProvider is loaded at runtime.
# See docs/architecture/CLOUD-PORTABILITY.md for full reference.
GLOBALSEC_CLOUD_PROVIDER=azure                 # azure | aws | gcp | kubernetes

# ============ PLATFORM ============
GLOBALSEC_REGION=apac                          # apac | emea | amer | gcc | africa | me | global
GLOBALSEC_ENV=production                       # development | staging | production
GLOBALSEC_DEPLOYMENT_MODE=regional             # regional | global
GLOBALSEC_SECRET_NAMESPACE=globalsec
GLOBALSEC_EVENT_NAMESPACE=globalsec
GLOBALSEC_OBJECT_BUCKET=globalsec-artifacts
PAPERCLIP_URL=http://paperclip:9000

# ============ AZURE PROVIDER (when GLOBALSEC_CLOUD_PROVIDER=azure) ============
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_KEYVAULT_URL=https://kv-globalsec-apac-prod.vault.azure.net
AZURE_SERVICEBUS_NAMESPACE=sb-globalsec-apac.servicebus.windows.net
AZURE_STORAGE_ACCOUNT_URL=https://stglobalsecapac.blob.core.windows.net

# ============ AWS PROVIDER (when GLOBALSEC_CLOUD_PROVIDER=aws) ============
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ROLE_ARN=                                  # IRSA role
AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/eks.amazonaws.com/serviceaccount/token

# ============ GCP PROVIDER (when GLOBALSEC_CLOUD_PROVIDER=gcp) ============
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT=

# ============ KUBERNETES-NEUTRAL (when GLOBALSEC_CLOUD_PROVIDER=kubernetes) ============
VAULT_ADDR=https://vault.globalsec.internal
VAULT_ROLE=globalsec-agent
KAFKA_BOOTSTRAP_SERVERS=kafka-0.kafka:9092,kafka-1.kafka:9092,kafka-2.kafka:9092
MINIO_ENDPOINT=minio.globalsec.internal:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true

# ============ ENTRA ID (Section 2.1 LLD) ============
# App: globalsec-entra-id-agent
ENTRA_TENANT_ID=                               # in kv: entra-tenant-id
ENTRA_CLIENT_ID=                               # in kv: entra-client-id
ENTRA_CLIENT_SECRET=                           # in kv: entra-client-secret

# ============ CROWDSTRIKE (EDR — Section 3.1 LLD) ============
CROWDSTRIKE_CLIENT_ID=                         # in kv: crowdstrike-client-id (per region)
CROWDSTRIKE_CLIENT_SECRET=                     # in kv: crowdstrike-client-secret
CROWDSTRIKE_BASE_URL=                          # in kv: crowdstrike-base-url

# ============ PROOFPOINT TAP (Email — Section 4.1 LLD) ============
PROOFPOINT_SP=
PROOFPOINT_SECRET=

# ============ CYBERARK PAM (Section 2.3 LLD) ============
CYBERARK_PVWA_URL=https://privilegecloud.cyberark.cloud/PasswordVault
CYBERARK_APP_ID=globalsec-pam-agent
CYBERARK_API_KEY=

# ============ CISCO UMBRELLA DNS (Section 5.1 LLD) ============
UMBRELLA_ORG_ID=
UMBRELLA_REPORTING_KEY=
UMBRELLA_REPORTING_SECRET=
UMBRELLA_ENFORCEMENT_KEY=
UMBRELLA_ENFORCEMENT_SECRET=

# ============ NETSKOPE (SSE — Section 5.2 LLD) ============
NETSKOPE_TENANT_URL=https://yourtenant.goskope.com
NETSKOPE_API_TOKEN=

# ============ DARKTRACE (NDR — Section 5.3 LLD) ============
DARKTRACE_API_KEY=
DARKTRACE_PRIVATE_KEY=
DARKTRACE_HOST=https://your-instance.darktrace.com

# ============ CLOUDFLARE (WAF/CDN — Section 6.1, 5.4 LLD) ============
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_IDS=                           # comma-separated

# ============ AZURE FRONT DOOR (Section 6.1 LLD) ============
AZURE_FRONT_DOOR_RG=
AZURE_FRONT_DOOR_NAME=

# ============ SALT SECURITY (API — Section 6.2 LLD) ============
SALT_API_TOKEN=
SALT_API_BASE_URL=https://app.salt.security

# ============ CHECKMARX (SAST — Section 6.3 LLD) ============
CHECKMARX_API_KEY=
CHECKMARX_HOST=https://ast.checkmarx.net
CHECKMARX_TENANT=

# ============ SNYK (DAST/SCA — Section 6.4 LLD) ============
SNYK_API_TOKEN=
SNYK_ORG_ID=

# ============ LOOKOUT (MTD — Section 6.5 LLD) ============
LOOKOUT_API_KEY=
LOOKOUT_TENANT_ID=

# ============ VARONIS (DSPM — Section 7.3 LLD) ============
VARONIS_API_TOKEN=
VARONIS_API_HOST=

# ============ MICROSOFT SENTINEL (Section 8.1 LLD) ============
SENTINEL_GLOBAL_WORKSPACE_ID=
SENTINEL_REGIONAL_WORKSPACE_IDS=               # JSON: {"apac":"...","emea":"..."}
SENTINEL_RESOURCE_GROUP=rg-globalsec-global

# ============ SERVICENOW (IR + GRC — Section 8.3 LLD) ============
SERVICENOW_INSTANCE=https://acme.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# ============ PAGERDUTY (Section 8.3 LLD) ============
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# ============ WIZ (CSPM/CNAPP — Section 9.1 LLD) ============
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_API_ENDPOINT=https://api.us27.app.wiz.io/graphql

# ============ RECORDED FUTURE (Threat Intel — Section 10.1 LLD) ============
RECORDED_FUTURE_API_TOKEN=

# ============ ZEROFOX (Brand Protection — Section 10.2 LLD) ============
ZEROFOX_API_TOKEN=
ZEROFOX_ACCOUNT_ID=

# ============ ILLUSIVE (Deception — Section 10.3 LLD) ============
ILLUSIVE_API_KEY=
ILLUSIVE_HOST=

# ============ AXONIUS (Asset Mgmt — Section 11.1 LLD) ============
AXONIUS_HOST=
AXONIUS_API_KEY=
AXONIUS_API_SECRET=

# ============ TENABLE ONE (Vuln Mgmt — Section 11.2 LLD) ============
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# ============ DEFENDER EASM (Section 11.5 LLD) ============
DEFENDER_EASM_RG=
DEFENDER_EASM_RESOURCE=

# ============ VEEAM (Backup — Section 12.1 LLD) ============
VEEAM_API_TOKEN=
VEEAM_HOST=

# ============ ONETRUST (TPRM — Section 13.1 LLD) ============
ONETRUST_API_TOKEN=
ONETRUST_HOST=
SECURITYSCORECARD_API_TOKEN=

# ============ MICROSOFT TEAMS (Section 14.1 LLD) ============
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_BOT_FRAMEWORK_APP_ID=
TEAMS_BOT_FRAMEWORK_PASSWORD=

# ============ SLACK (Section 14.1 LLD) ============
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# ============ DATABASE ============
DB_HOST=psql-globalsec-global-prod.postgres.database.azure.com
DB_PORT=5432
DB_NAME=globalsec
DB_USER=globalsec_app
DB_PASSWORD=
DB_SSLMODE=require

# ============ REDIS ============
REDIS_HOST=redis-globalsec-global-prod.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL=true
